# ==============================================================================
# Environment Configuration Template for Personal URL Shortener
# Copy this file to .env.local for local development.
# Never commit real secrets to version control.
# ==============================================================================

# Canonical production origin (used for absolute OG image links & redirects)
SITE_URL="https://linkskie.vercel.app"
NEXT_PUBLIC_SITE_URL="https://linkskie.vercel.app"

# Persistent Key-Value Storage (Upstash Redis)
# Obtain from your Upstash console (https://console.upstash.com) or Vercel Marketplace
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# Rate Limiting Configuration (Server-side abuse prevention)
# Number of requests allowed per client IP within the window duration
RATE_LIMIT_REQUESTS=15
RATE_LIMIT_WINDOW_SECONDS=60
